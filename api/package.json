{
  "name": "api",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "db": "json-server --watch db.json --port 3001",
    "server": "node --watch server.js",
    "dev": "concurrently -n db,api \"npm run db\" \"npm run server\""
  },
  "dependencies": {
    "concurrently": "^10.0.6",
    "express": "^5.3.0",
    "json-server": "^0.17.4"
  }
}
